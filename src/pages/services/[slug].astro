---
import ServiceLockup from '../../components/ServiceLockup.astro';
import Trait from '../../components/Trait.astro';
import { PICTOS, PICTOS_PROVISOIRES } from '../../lib/pictos';
import Visuel from '../../components/Visuel.astro';
import FilVague from '../../components/FilVague.astro';
// Gabarit des pages de service (modèle : MODELES/SERVICE.html). Tout le contenu vient du CMS.
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Sections from '../../components/Sections.astro';
import { services, sectionsDe, reglages, menu } from '../../lib/contenu';

export async function getStaticPaths() {
  return (await services()).map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const r = await reglages();
const sections = await sectionsDe(`/services/${s.slug}`);
const aide = (await menu('boutons')).find((b) => b.lien === '/aide');
const aDesInfos = sections.some((x) => x.type === 'infos');
// Override photo hero avec la sélection Alexandra (le temps que le CMS soit mis à jour).
const OVERRIDES_PHOTO: Record<string, { src: string; alt: string }> = {
  'le-rebond':       { src: '/img/claptis-boxing.png',             alt: 'Un homme avec des gants de boxe' },
  'chez-toit':       { src: '/img/claptis-hublot.png',             alt: 'Une jeune femme regarde dans le hublot d’une machine à laver' },
  'toudi-boudji':    { src: '/img/claptis-cuisine-collective.png', alt: 'Deux hommes dans la cuisine collective' },
  'parent-elle':     { src: '/img/claptis-barbapapa.webp',         alt: 'Une cuisinette Barbapapa pour enfants' },
  'promotion-sante': { src: '/img/claptis-infirmerie.webp',        alt: 'Le matériel de l’infirmerie' },
};
const over = OVERRIDES_PHOTO[s.slug];
const photoSrc = over?.src ?? s.photo;
const photoAlt = over?.alt ?? s.photo_alt ?? '';
---
<Base titre={s.nom} description={s.description_seo || s.accroche} theme={s.theme}>
  <section class="tete tete-service"><div class="wrap">
    <div>
      <p class="ariane"><a href="/services">{s.ariane}</a> &nbsp;›&nbsp; {s.nom}</p>
      <h1 class="titre-service">{(PICTOS[s.slug] || PICTOS_PROVISOIRES[s.slug] || s.picto) && <ServiceLockup service={s.slug} theme={s.theme} picto={s.picto} class="grand" />}<span>{s.nom}</span></h1>
      {s.accroche && <p class="accroche">{s.accroche}</p>}
      {s.chapo && <p class="chapo">{s.chapo}</p>}
      <div class="cta">
        {aDesInfos && r.bouton_infos && <a class="btn plein" href="#infos">{r.bouton_infos} <Icone nom="fleche" /></a>}
        {aide && <a class="btn contour" href={aide.lien}>{aide.libelle}</a>}
      </div>
    </div>
    {!photoSrc && (
      <div class="visuel visuel-trait" aria-hidden="true">
        <Trait variante="boucle-droite" graine={`/services/${s.slug}:tete-trait`} couleur={['rouge', 'bleu', 'jaune', 'vert', 'mauve'].includes(s.theme) ? s.theme : 'rouge'} epaisseur={6} />
      </div>
    )}
    {photoSrc && (
      <div class="visuel">
        <Visuel class="ph" ref={photoSrc} alt={photoAlt} graine={`/services/${s.slug}:photo`} couleur={s.theme} loading="eager" aplat={s.aplat ?? false} contour={s.trait !== false} />
      </div>
    )}
  </div>
  </section>
  <FilVague graine={`/services/${s.slug}:fil`} couleur={s.theme} noeud={0.3} />

  <Sections sections={sections} axe={s.theme} />
</Base>
