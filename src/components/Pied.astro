---
import Media from './Media.astro';
import Logo from './Logo.astro';
import { reglages, menu, lire } from '../lib/contenu';
import Icone from './Icone.astro';

const r = await reglages();
const services = await menu('pied_services');
const pratique = await menu('pied_pratique');
const don = (await menu('boutons')).find((b) => b.icone === 'coeur');
const tel = (r.telephone ?? '').replace(/\D/g, '');
// Les soutiens de l'association, sur toutes les pages juste avant le pied (la page Partenaires a son propre bloc)
const soutiens = Astro.url.pathname.startsWith('/partenaires') ? [] : await lire('partenaires', (x) => x.type === 'financeur');
---
{soutiens.length > 0 && <section class="bloc serre partenaires bande-soutiens" aria-labelledby="titre-soutiens"><div class="wrap">
  <span class="sur">Ils nous soutiennent</span>
  <h2 class="h2" id="titre-soutiens">Partenaires de {r.nom}</h2>
  <ul class={`parts${soutiens.some((x) => x.logo) ? ' avec-logos' : ''}`}>
    {soutiens.map((x) => { const contenu = x.logo ? <Media class="logo-partenaire" ref={x.logo} alt={x.nom} loading="lazy" /> : <span>{x.nom}</span>; return <li>{x.site ? <a href={x.site} target="_blank" rel="noopener" aria-label={x.logo ? `${x.nom} (nouvel onglet)` : undefined}>{contenu}</a> : contenu}</li>; })}
  </ul>
</div></section>}
<footer><div class="wrap">
  <div class="cols">
    <div>
      <a class="brand" href="/accueil" aria-label={`${r.nom}, accueil`}><Logo nom={r.nom} variante="blanc" /></a>{r.sous_nom && <p class="sous-nom">{r.sous_nom}</p>}
      {r.slogan && <p class="slogan">{r.slogan}</p>}
      {don && <a class="btn plein" href={don.lien}>{don.libelle} <Icone nom="fleche" /></a>}
    </div>
    <div><h2>{r.pied_titre_services}</h2><ul>
      {services.map((m) => <li><a href={m.lien}>{m.libelle}</a></li>)}
    </ul></div>
    <div><h2>{r.pied_titre_trouver}</h2><ul>
      <li>{r.adresse_ligne1}<br />{r.adresse_ligne2}</li>
      {r.telephone && <li><a href={`tel:${tel}`}>{r.telephone}</a></li>}
      {r.email && <li><a href={`mailto:${r.email}`}>{r.email}</a></li>}
    </ul></div>
    <div><h2>{r.pied_titre_pratique}</h2><ul>
      {pratique.map((m) => <li><a href={m.lien}>{m.libelle}</a></li>)}
    </ul></div>
  </div>
  {r.phrase_fin && <div class="bas"><p>{r.phrase_fin}</p></div>}
</div></footer>
{r.credit_lien && <a class="realise-par" href={r.credit_lien} target="_blank" rel="noopener">
  {r.credit_logo && <Media ref={r.credit_logo} alt="" width="32" height="32" />}
  <span>{r.credit_libelle}</span>
</a>}
