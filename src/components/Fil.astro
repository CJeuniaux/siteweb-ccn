---
// Trait de stylo (une ou plusieurs lignes centrales) rendu en formes pleines par traitStylo().
// Avec anime, chaque forme est révélée le long de son geste par un masque dont le trait se dessine
// (stroke-dashoffset, voir .fil-masque dans commun.css) : le fil « s'écrit » sous les yeux du visiteur.
import { traitStylo, echantillonner, type P } from '../lib/stylo';

interface Props {
  traits: P[][]; largeur: number; hauteur: number; graine: string;
  epaisseur?: number; anime?: boolean; class?: string; style?: string;
  /** Marge (unités du viewBox) autour du dessin que le masque doit couvrir : le trait peut déborder du cadre */
  marge?: number;
  preserveAspectRatio?: string;
}
const { traits, largeur, hauteur, graine, epaisseur = 5, anime = false, class: classe = '', style, marge = 240, preserveAspectRatio } = Astro.props;
const formes = traits.map((t, i) => traitStylo(t, { epaisseur, graine: `${graine}:contour:${i}` }));
const idBase = 'fil-' + graine.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase();
const f = (v: number) => Math.round(v * 10) / 10;
const centres = anime ? traits.map((t) => echantillonner(t, 8).map(([x, y], k) => `${k ? 'L' : 'M'}${f(x)} ${f(y)}`).join('')) : [];
---
<svg class={`fil ${classe}`.trim()} viewBox={`0 0 ${largeur} ${hauteur}`} style={style} preserveAspectRatio={preserveAspectRatio} aria-hidden="true" focusable="false">
  {anime && (
    <defs>
      {centres.map((d, i) => (
        <mask id={`${idBase}-${i}`} class="fil-masque" maskUnits="userSpaceOnUse" x={-marge} y={-marge} width={largeur + marge * 2} height={hauteur + marge * 2}>
          <path d={d} pathLength="1" fill="none" stroke="#fff" stroke-width={epaisseur * 7} stroke-linecap="round" stroke-linejoin="round" style={`--ordre:${i}`} />
        </mask>
      ))}
    </defs>
  )}
  {formes.map((d, i) => <path d={d} mask={anime ? `url(#${idBase}-${i})` : undefined} />)}
</svg>
