---
// « Le fil » de la charte : un trait libre et continu qui traverse la composition d'un bord à l'autre,
// se noue une fois en bouclette et repart. Fin, mauve, presque régulier — il relie les personnes, les
// services et les parcours. Il s'écrit au rythme du défilement (.fil-scroll, Base.astro).
import Fil from './Fil.astro';
import { hasard } from '../lib/pinceau';
import { boucle, type P } from '../lib/stylo';

interface Props {
  graine: string; couleur?: string; class?: string;
  /** Position de la bouclette le long du trait (0 = à gauche, 1 = à droite) */
  noeud?: number;
  /** Sens de la pente générale : 1 descend vers la droite, -1 remonte */
  pente?: number;
}
const { graine, couleur = 'mauve', class: classe = '', noeud = 0.72, pente = 1 } = Astro.props;
const L = 1600, H = 190, milieu = H / 2;
const h = hasard(`fil-traversant:${graine}`).n;
const ph = [h(), h(), h()].map((v) => v * Math.PI * 2);
const amp = 30 + h() * 14;

const avant: P[] = [], apres: P[] = [];
const xNoeud = L * noeud;
const onde = (x: number) => milieu + pente * ((x / L - 0.5) * 26) + amp * Math.sin((x / L) * 4.6 + ph[0]) * 0.8 + amp * 0.35 * Math.sin((x / L) * 9.3 + ph[1]);
for (let x = -40; x <= L + 40; x += 32) (x < xNoeud ? avant : apres).push([x, onde(x)]);
const [nx, ny] = avant[avant.length - 1];
const trait: P[] = [...avant, ...boucle(nx + 34, ny - 30, 30, 1, Math.PI * 0.72), ...apres.map(([x, y]) => [x + 26, y] as P)];
const teinte = /^[a-z]+$/.test(couleur) ? `var(--${couleur})` : couleur;
---
<Fil class={`fil-traversant ${classe}`.trim()} traits={[trait]} largeur={L} hauteur={H} epaisseur={4} graine={`fil-traversant:${graine}`} anime marge={90} style={`--t:${teinte}`} />
