---
// Photo de contenu (PhotoCutout). Charte : photo noir et blanc contrastée, détourée, fin liseré blanc
// irrégulier (filtre #lisere, Base.astro), un trait de stylo qui l'entoure, et en option un aplat de pinceau
// derrière (composant Aplat, créé par le code, jamais incrusté dans le fichier).
// Selon le type de l'image dans la médiathèque :
// - detoure   : PNG/WebP transparent → contour griffonné qui suit la silhouette
// - photo / composite : image non détourée (provisoire) → cadre griffonné ; « composite » garde le
//               correctif .img-provisoire (ancien aplat incrusté fondu dans la page) en attendant le détourage
// - dessin    : SVG → affiché tel quel
import Media from './Media.astro';
import Aplat from './Aplat.astro';
import { image } from '../lib/contenu';
import { pose } from '../lib/pinceau';
import { contourGriffonne, bordsCoupes, type Griffon } from '../lib/trait';
import { contourSouple, cheminLisse } from '../lib/fils';
import { formePhoto } from '../lib/formes';
import { hasard } from '../lib/pinceau';
import Trait from './Trait.astro';

interface Props {
  ref?: string | null; alt?: string; graine: string;
  /** Couleur de la section / du service : trait (et aplat s'il est demandé) */
  couleur?: string; class?: string; loading?: 'lazy' | 'eager';
  /** Trait de stylo autour de la photo : true (par défaut) ou false */
  contour?: boolean;
  /** Le trait se dessine à l'arrivée sur la page (héros de l'accueil) */
  anime?: boolean;
  /** Aplat de pinceau derrière la photo : numéro de forme (0-6) ou false (par défaut : aucun, choix de Charlotte du 15/11) */
  aplat?: number | false;
  /** Forme organique qui découpe la photo : numéro (0-5) pour l'imposer, false pour garder la photo telle quelle.
   *  Par défaut : oui dès que le trait est demandé (planche « Photographies des services »). */
  forme?: number | boolean;
  /** La forme est retournée (photo placée à gauche du texte) */
  miroir?: boolean;
}
const { ref, alt, graine, couleur = 'rouge', class: classe = '', loading, contour = true, anime = false, aplat = false, forme, miroir = false } = Astro.props;
const img = await image(ref);
const type = img?.type ?? 'composite';
const cote = pose(graine).cote;
// Fondu automatique des bords coupés net (détourées) : dégradé sur 10 % du côté concerné, sans recadrer.
let masque: string | undefined;
if (img && type === 'detoure') {
  const b = await bordsCoupes(img.srcOriginal ?? img.src);
  const g: string[] = [];
  if (b?.bas || b?.haut) g.push(`linear-gradient(to bottom,${b.haut ? 'transparent,#000 10%' : '#000'},${b.bas ? '#000 90%,transparent' : '#000'})`);
  if (b?.gauche || b?.droite) g.push(`linear-gradient(to right,${b.gauche ? 'transparent,#000 10%' : '#000'},${b.droite ? '#000 90%,transparent' : '#000'})`);
  if (g.length) masque = `-webkit-mask-image:${g.join(',')};mask-image:${g.join(',')};-webkit-mask-composite:source-in;mask-composite:intersect;-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat`;
}

// Charte : la photo est cernée d'une forme souple et organique, qui respire autour d'elle.
// Elle ne suit pas la silhouette et n'encadre pas non plus : c'est un geste, large et continu.
// Photo découpée dans une forme organique (masque), aplat gris-beige décalé, trait fin partiel
const enForme = !!img && type !== 'dessin' && (forme ?? contour) !== false;
const ratio = img?.largeur && img?.hauteur ? Math.min(1.5, Math.max(1.05, +img.largeur / +img.hauteur)) : 1.4;
const LT = 560, HT = Math.round(LT / ratio);   // repère du trait, proche de sa taille à l'écran
const fo = enForme ? formePhoto(graine, typeof forme === 'number' ? forme : undefined, miroir, LT, HT) : null;
const idForme = 'forme-' + Math.floor(hasard('id-forme:' + graine).n() * 1e9).toString(36);
// Proportions du cadre : celles de la photo, bornées pour que la forme reste ample
let griffon: Griffon | null = null, silhouette = false;
if (img && contour && type !== 'dessin' && !enForme) {
  if (type === 'detoure') { griffon = await contourGriffonne(img.srcOriginal ?? img.src, graine); silhouette = !!griffon; }
  if (!griffon && img.largeur && img.hauteur) griffon = contourSouple(+img.largeur, +img.hauteur, graine);
}
const teinte = /^[a-z]+$/.test(couleur) ? `var(--${couleur})` : couleur;
---
{img && (
  type === 'dessin' ? (
    <Media class={classe} ref={ref} alt={alt} loading={loading} />
  ) : fo ? (
    <figure class={`photo-detouree en-forme ${miroir ? 'miroir ' : ''}${classe}`.trim()} data-type={type} style={`--t:${teinte};--ratio:${ratio.toFixed(3)}`}>
      <svg class="forme-defs" width="0" height="0" aria-hidden="true" focusable="false"><clipPath id={idForme} clipPathUnits="objectBoundingBox"><path d={fo.masque} /></clipPath></svg>
      <svg class="aplat-fond" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={fo.aplat} /></svg>
      <div class="forme-masque" style={`clip-path:url(#${idForme})`}>
        {type === 'detoure' && <Aplat class="forme-pinceau" couleur="var(--gris-photo)" graine={`fond:${graine}`} opacite={1} tourner={false} />}
        <Media class="photo-image" ref={ref} alt={alt} loading={loading} />
      </div>
      {contour && <svg data-trace class="photo-trait" viewBox={`0 0 ${LT} ${HT}`} aria-hidden="true" focusable="false"><path d={fo.trait} pathLength="1" /></svg>}
      {contour && <Trait variante="eclat" graine={`${graine}:eclat`} couleur={couleur} class="forme-eclat" />}
    </figure>
  ) : (
    <figure class={`photo-detouree cote-${cote} ${classe}`.trim()} data-type={type} style={`--t:${teinte}`}>
      {/* Charte : la photo repose sur un coup de pinceau gris, jamais incrusté dans le fichier */}
      {aplat === false
        ? type === 'detoure' && <Aplat class="aplat-fond" couleur="var(--pinceau)" graine={`pinceau:${graine}`} opacite={0.75} />
        : <Aplat class="aplat-fond" couleur={couleur} graine={graine} variante={aplat} opacite={0.9} />}
      <Media class={`photo-image${type === 'composite' ? ' img-provisoire' : ''}`} ref={ref} alt={alt} loading={loading} style={masque} />
      {griffon && (
        <svg data-trace class={silhouette ? "photo-trait silhouette" : "photo-trait"} viewBox={`0 0 ${griffon.largeur} ${griffon.hauteur}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d={cheminLisse(griffon.traits[0])} pathLength="1" />
        </svg>
      )}
    </figure>
  )
)}
