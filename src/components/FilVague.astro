---
// Le fil sous l'en-tête d'une page. C'est le geste « relier » dessiné par Charlotte, posé à sa propre
// échelle (sa boucle n'est jamais étirée), puis prolongé jusqu'aux deux bords dans son élan.
// Trait fin, couleur de la page, immobile. La graine décide de la place du geste et de son sens
// (boucle à gauche ou à droite, au-dessus ou en dessous) : deux pages n'ont pas le même trait.
import { cheminLisse } from '../lib/fils';
import { hasard } from '../lib/pinceau';
import dessins from '../lib/dessins.json';
import type { P } from '../lib/stylo';

interface Props { graine: string; couleur?: string; noeud?: number; class?: string }
const { graine, couleur = 'encre', class: classe = '' } = Astro.props;
const L = 1600, H = 150;
const h = hasard(`vague:${graine}`).n;
const g = dessins.relier, base = g.traits[0] as P[];
const ech = (520 + h() * 160) / g.largeur;                // largeur du geste : 520 à 680 unités
const miroirX = h() < 0.5, miroirY = h() < 0.4;
const lg = g.largeur * ech, ht = g.hauteur * ech;
const x0 = 420 + h() * (L - 840 - lg > 0 ? L - 840 - lg : 0), y0 = (H - ht) / 2;
let geste = base.map(([x, y]) => [x0 + (miroirX ? g.largeur - x : x) * ech, y0 + (miroirY ? g.hauteur - y : y) * ech] as P);
if (miroirX) geste = geste.reverse();
// Prolongements : la ligne arrive et repart en ondulant à peine, dans la direction de ses extrémités
const [ax, ay] = geste[0], [bx, by] = geste[geste.length - 1];
const ph = h() * 6.28;
const avant: P[] = [], apres: P[] = [];
for (let x = -300; x < ax - 60; x += 110) avant.push([x, ay + Math.sin(x / 260 + ph) * 9 * Math.min(1, (ax - x) / 300)]);
for (let x = bx + 110; x <= L + 300; x += 110) apres.push([x, by + Math.sin(x / 240 + ph) * 9 * Math.min(1, (x - bx) / 300)]);
const d = cheminLisse([...avant, ...geste, ...apres]);
const teinte = /^[a-z]+$/.test(couleur) ? `var(--${couleur})` : couleur;
---
<svg class={`fil-vague ${classe}`.trim()} viewBox={`0 0 ${L} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" style={`--t:${teinte}`}>
  <path d={d} />
</svg>
