---
// La ligne à boucle de la charte : le geste « relier » dessiné par Charlotte, à sa propre échelle.
// Elle n'est plus tirée d'un bord à l'autre de la page — seule dans un grand vide, elle n'avait pas de
// fonction. Elle fait la transition entre l'en-tête et la suite, courte, et sa composition change d'une
// page à l'autre : à gauche ou à droite, plus ou moins longue, boucle dessus ou dessous, en miroir ou non.
// Elle se dessine à l'apparition (data-trace). Couleur de la page.
import { cheminLisse } from '../lib/fils';
import { hasard } from '../lib/pinceau';
import dessins from '../lib/dessins.json';
import type { P } from '../lib/stylo';

interface Props { graine: string; couleur?: string; noeud?: number; class?: string }
const { graine, couleur = 'encre', class: classe = '' } = Astro.props;
const h = hasard(`vague:${graine}`).n;
const g = dessins.relier, base = g.traits[0] as P[];
const miroirX = h() < 0.5, miroirY = h() < 0.4;
const largeur = Math.round(300 + h() * 220);          // 300 à 520 px
const cote = h() < 0.5 ? 'gauche' : 'droite';
const decal = Math.round(h() * 14);                    // retrait depuis le bord du contenu, en %
let pts = base.map(([x, y]) => [miroirX ? g.largeur - x : x, miroirY ? g.hauteur - y : y] as P);
if (miroirX) pts = pts.reverse();
const teinte = /^[a-z]+$/.test(couleur) ? `var(--${couleur})` : couleur;
---
<div class={`fil-vague wrap ${classe}`.trim()} aria-hidden="true">
  <svg data-trace viewBox={`0 0 ${g.largeur} ${g.hauteur}`} focusable="false"
       style={`--t:${teinte};width:min(${largeur}px,70%);margin-${cote === 'gauche' ? 'left' : 'right'}:${decal}%;${cote === 'droite' ? 'margin-left:auto' : ''}`}>
    <path d={cheminLisse(pts)} pathLength="1" />
  </svg>
</div>
