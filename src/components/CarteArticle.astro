---
import Visuel from './Visuel.astro';
// Carte d'un article (liste Actualités, « À lire aussi »).
import Icone from './Icone.astro';
interface Props { a: Record<string, any>; lire: string; mentionExemple?: string; titreNiveau?: 'h2' | 'h3'; index?: number }
const { a, lire, mentionExemple, titreNiveau = 'h2', index = 0 } = Astro.props;
const themes = ['rouge', 'bleu', 'jaune', 'vert'];
const Titre = titreNiveau;
const lien = a.lien_externe || `/actualites/${a.slug}`;
---
<a class={`carte-article t-${themes[index % themes.length]}`} href={lien} data-categorie={a.categorie}>
  {a.image ? <Visuel ref={a.image} alt={a.image_alt ?? ''} graine={`carte:${a.slug}`} couleur={themes[index % themes.length]} loading="lazy" /> : <div class="carte-placeholder" aria-hidden="true" />}
  <p class="meta">{a.categorie}{a.date_affichee && <> · {a.date_affichee}</>}{a.exemple && mentionExemple && <span class="exemple">{mentionExemple}</span>}</p>
  <Titre>{a.titre}</Titre>
  {a.resume && <p>{a.resume}</p>}
  <span class="plus">{lire} <Icone nom="fleche" /></span>
</a>
