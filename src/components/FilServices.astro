---
// Le fil qui relie les services (accueil). Deux tracés, le CSS n'en montre qu'un :
// - .fil-ronde (écran large) : un cercle tracé à la main, qui part de derrière le premier badge, fait le tour
//   en passant derrière chacun et se referme un peu après son départ, le stylo s'écartant en se levant ;
// - .fil-colonne (mobile) : un fil presque droit qui descend derrière la colonne des badges.
// Le trait se dessine au rythme du défilement (voir .fil-scroll dans Base.astro).
import Fil from './Fil.astro';
import { hasard } from '../lib/pinceau';
import type { P } from '../lib/stylo';

interface Props { graine: string; couleur?: string }
const { graine, couleur = 'encre' } = Astro.props;
const h = hasard(`fil-services:${graine}`).n;
const ph = [h(), h(), h()].map((v) => v * Math.PI * 2);

// Cercle : rayon 500, départ 8° avant le haut (caché par le badge), 22° de recouvrement à l'arrivée
const R = 500, debut = -90 - 4, fin = -90 + 360 + 22;
const cercle: P[] = [];
for (let a = debut; a <= fin; a += 4) {
  const r = (a * Math.PI) / 180;
  const souffle = 1 + 0.011 * Math.sin(3 * r + ph[0]) + 0.006 * Math.sin(7 * r + ph[1]);
  const levee = a > fin - 22 ? ((a - (fin - 22)) / 22) ** 2 * 20 : 0;
  cercle.push([Math.cos(r) * (R * souffle + levee), Math.sin(r) * (R * souffle + levee)]);
}

// Colonne : de haut en bas, légèrement ondulée (repère 100 × 1000, étiré sur la hauteur de la liste)
const colonne: P[] = [];
for (let y = 0; y <= 1000; y += 40) colonne.push([50 + 5 * Math.sin((y / 1000) * 5 + ph[2]) + (h() - 0.5) * 2, y]);
const teinte = /^[a-z]+$/.test(couleur) ? `var(--${couleur})` : couleur;
---
<Fil class="fil-ronde" traits={[cercle]} largeur={1080} hauteur={1080} epaisseur={7} graine={`fil-services:${graine}:ronde`} anime marge={60} style={`--t:${teinte}`} viewBox="-540 -540 1080 1080" />
<Fil class="fil-colonne" traits={[colonne]} largeur={100} hauteur={1000} epaisseur={4} graine={`fil-services:${graine}:colonne`} anime marge={30} preserveAspectRatio="none" style={`--t:${teinte}`} />
