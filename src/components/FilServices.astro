---
// Le fil qui relie les services (accueil) : un trait souple, à hauteur des badges, qui ondule doucement
// d'un picto à l'autre (comme une ficelle tenue entre eux) et finit par une petite bouclette après le
// dernier. Reste dans la bande des badges : ne descend jamais dans les titres/textes en dessous.
// Se dessine (comme écrit au stylo) quand la bande entre dans l'écran (voir Fil.astro + commun.css).
import Fil from './Fil.astro';
import { hasard } from '../lib/pinceau';
import { boucle, type P } from '../lib/stylo';

interface Props { graine: string; nombre: number; couleur?: string; class?: string }
const { graine, nombre, couleur = 'encre', class: classe = '' } = Astro.props;
const L = 1200, H = 150, milieu = 62, amplitude = 24;
const h = hasard(`fil-services:${graine}`).n;

const ancres: P[] = Array.from({ length: nombre }, (_, i) => {
  const x = (L / nombre) * (i + 0.5);
  const sens = i % 2 === 0 ? -1 : 1;
  return [x, milieu + sens * amplitude * (0.85 + h() * 0.3)] as P;
});
const pts: P[] = [[ancres[0][0] - 64, milieu], ...ancres, [ancres[ancres.length - 1][0] + 40, milieu]];
const [fx, fy] = pts[pts.length - 1];
pts.push([fx + 14, fy + 8], ...boucle(fx + 32, fy + 16, 13, -1, Math.PI), [fx + 46, fy + 6]);
const teinte = /^[a-z]+$/.test(couleur) ? `var(--${couleur})` : couleur;
---
<Fil class={`fil-services ${classe}`.trim()} traits={[pts]} largeur={L} hauteur={H} epaisseur={4} graine={`fil-services:${graine}`} anime marge={60} preserveAspectRatio="none" style={`--t:${teinte}`} />
