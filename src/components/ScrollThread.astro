---
// « Le fil » de l'accueil : le tracé dessiné par Charlotte (A-INTEGRER/fil-accueil.png), extrait en
// ligne par scripts/vectoriser.mjs. Il est posé sur toute la hauteur de la page, derrière le contenu,
// en trait fin, et s'écrit au rythme du défilement. Rien n'est calculé ici : la forme est la sienne.
---
<div class="fil-page" aria-hidden="true"><svg class="fil-trace"><path /></svg></div>

<script>
  import dessins from '../lib/dessins.json';
  import { cheminLisse } from '../lib/fils';
  import type { P } from '../lib/stylo';

  const dessin = dessins['fil-accueil'];
  let trace: SVGPathElement | null = null, zone: HTMLElement | null = null;
  // Pour chaque point : la profondeur atteinte et la part du trait parcourue. La révélation suit la
  // profondeur : une boucle se dessine quand on arrive à sa hauteur.
  let profondeur: Array<[number, number]> = [];
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function construire() {
    zone = document.querySelector('.fil-page');
    const svg = zone?.querySelector('.fil-trace') as SVGSVGElement | null;
    trace = svg?.querySelector('path') ?? null;
    if (!zone || !svg || !trace) return;
    const W = zone.offsetWidth, H = zone.offsetHeight;
    if (!W || !H) return;
    // Le dessin occupe la largeur de la page (avec une marge) et toute sa hauteur
    const marge = W < 768 ? 14 : Math.max(40, (W - 1240) / 2 - 10);
    const haut = 90, bas = 40;
    const ex = (W - marge * 2) / dessin.largeur, ey = (H - haut - bas) / dessin.hauteur;
    const pts = (dessin.traits[0] as P[]).map(([x, y]) => [marge + x * ex, haut + y * ey] as P);

    const L = [0];
    for (let i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    const tot = L[L.length - 1] || 1;
    let plusBas = -Infinity;
    profondeur = pts.map((p, i) => { plusBas = Math.max(plusBas, p[1]); return [plusBas, L[i] / tot]; });

    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('width', String(W));
    svg.setAttribute('height', String(H));
    trace.setAttribute('d', cheminLisse(pts));
    trace.setAttribute('pathLength', '1');
    trace.style.strokeDasharray = '1';
    trace.style.strokeDashoffset = reduit ? '0' : '1';
    if (!reduit) tracer();
  }

  let prevu = false;
  function tracer() {
    prevu = false;
    if (!trace || !zone || reduit || !profondeur.length) return;
    const r = zone.getBoundingClientRect();
    const cible = innerHeight * 0.78 - r.top; // la main écrit jusqu'aux trois quarts de l'écran
    if (profondeur[0][0] > cible) { trace.style.strokeDashoffset = '1'; return; }
    let lo = 0, hi = profondeur.length - 1;
    while (lo < hi) { const m = (lo + hi + 1) >> 1; if (profondeur[m][0] <= cible) lo = m; else hi = m - 1; }
    trace.style.strokeDashoffset = String(1 - profondeur[lo][1]);
  }
  const demander = () => { if (!prevu) { prevu = true; requestAnimationFrame(tracer); } };

  let minuteur: number;
  const refaire = () => { clearTimeout(minuteur); minuteur = setTimeout(construire, 160); };
  addEventListener('scroll', demander, { passive: true });
  addEventListener('resize', refaire);
  addEventListener('load', refaire);
  if ('ResizeObserver' in window) new ResizeObserver(refaire).observe(document.body);
  construire();
</script>
